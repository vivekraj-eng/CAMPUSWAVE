# ========================================================
# CAMPUSWAVE — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env and provide your deployment credentials.
# Do NOT place real secrets or service-role keys in this file.

# --------------------------------------------------------
# 1. Supabase Cloud Configuration (Required for live backend)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# --------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------
# 2. Live Radio Stream Configuration (Optional)
# Provide an active Icecast, Shoutcast, HLS, or direct MP3/AAC audio stream URL.
# Example: https://stream.campuswave.fm/live
# If left empty, CampusWave operates in the authentic "RADIO OFFLINE" state.
# --------------------------------------------------------
VITE_RADIO_STREAM_URL=

# --------------------------------------------------------
# 3. Campus & Station Metadata (Optional)
# --------------------------------------------------------
# Restricts submissions to official college emails (e.g., @college.edu)
VITE_COLLEGE_EMAIL_DOMAIN=

# Station contact and physical presence
VITE_STATION_EMAIL=
VITE_STATION_LOCATION=
VITE_STATION_FREQUENCY=

# Social channels (Only rendered when valid URLs starting with http are provided)
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_SPOTIFY=
